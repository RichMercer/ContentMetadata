<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ContentMetadata</RootNamespace>
    <AssemblyName>ContentMetadata</AssemblyName>
    <LangVersion>latest</LangVersion>

    <!-- Build output is mounted into the local Community stack at /app/cfs/plugins
         (see .devcontainer/compose.yml), matching the community-plugin template. -->
    <OutputPath>..\artifacts\build</OutputPath>
    <PublishDir>..\artifacts\publish</PublishDir>
    <PackageOutputPath>..\artifacts\package</PackageOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- Major version tracks the supported Verint Community version. -->
    <Version>14.0.1</Version>

    <PackageId>TelligentContentMetadata</PackageId>
    <Title>ContentMetadata for Verint Community</Title>
    <Authors>RichMercer</Authors>
    <Description>ContentMetadata for Verint Community adds support for Metadata on Verint Community IContent entities. It was built as a replacement for ExtendedAttributes for developers who were using them to store their own custom data.</Description>
    <PackageReleaseNotes>14.0.1: rejects keys over 64 characters instead of truncating them, hides internal error details from REST callers, and fixes stale cached values after a delete. 14.0.0: updated for Verint Community 14 and .NET 10. Metadata now lives in the plugin's own schema; data in the legacy dbo.custom_Metadata table is migrated automatically when the plugin is installed.</PackageReleaseNotes>
    <Copyright>Copyright 2026</Copyright>
    <PackageTags>Verint Community IContent Metadata ExtendedAttributes</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/RichMercer/ContentMetadata</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RichMercer/ContentMetadata</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbols and Source Link (built into the .NET SDK for GitHub repositories). -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Deterministic paths in CI builds so Source Link and reproducible builds work. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Both assemblies are supplied by the Community host at runtime, so they are
       compile-time only and never copied next to the plugin. -->
  <ItemGroup>
    <PackageReference Include="Verint.Community.Platform" Version="14.0.0.684">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Matches the version shipped in the Verint Community 14.0.0.684 web image. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- System.Security.Cryptography.Pkcs only reaches this project transitively through the
       compile-time Microsoft.Data.SqlClient reference above; it is never shipped with the plugin,
       and the Community host supplies its own copy at runtime. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Sql\Install.sql" />
    <EmbeddedResource Include="Resources\Sql\MigrateLegacyData.sql" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
