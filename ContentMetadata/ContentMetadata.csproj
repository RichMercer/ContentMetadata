<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ContentMetadata</RootNamespace>
    <AssemblyName>ContentMetadata</AssemblyName>
    <LangVersion>latest</LangVersion>

    <!-- Major version tracks the supported Verint Community version. -->
    <Version>14.0.0</Version>

    <PackageId>TelligentContentMetadata</PackageId>
    <Title>ContentMetadata for Verint Community</Title>
    <Authors>RichMercer</Authors>
    <Description>ContentMetadata for Verint Community adds support for Metadata on Verint Community IContent entities. It was built as a replacement for ExtendedAttributes for developers who were using them to store their own custom data.</Description>
    <PackageReleaseNotes>Updated for Verint Community 14 and .NET 10.</PackageReleaseNotes>
    <Copyright>Copyright 2026</Copyright>
    <PackageTags>Verint Community IContent Metadata ExtendedAttributes</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/RichMercer/ContentMetadata</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RichMercer/ContentMetadata</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Verint.Community.Platform" Version="14.0.0.684" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Overrides the vulnerable 9.0.18 pulled in by Microsoft.Data.SqlClient. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Sql\Install.sql" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
